<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GIMI_ModManager.WinUI.Views.CharacterDetailsPages.ModGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:subViewModels="using:GIMI_ModManager.WinUI.ViewModels.CharacterDetailsViewModels.SubViewModels"
    xmlns:xaml="using:GIMI_ModManager.WinUI.Helpers.Xaml"
    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <xaml:AttentionTypeToSymbolConverter x:Key="AttentionTypeToSymbolConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <controls:DataGrid
            x:Name="ModListGrid"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AreRowDetailsFrozen="True"
            AreRowGroupHeadersFrozen="True"
            AutoGenerateColumns="False"
            CanUserReorderColumns="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            CellEditEnded="ModListGrid_OnCellEditEnded"
            CellEditEnding="ModListGrid_OnCellEditEnding"
            ContextRequested="ModListGrid_OnContextRequested"
            FontSize="13"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{x:Bind ViewModel.GridMods, Mode=OneWay}"
            KeyDown="ModListGrid_OnKeyDown"
            RightTapped="ModListGrid_OnRightTapped"
            RowBackground="{ThemeResource LayerFillColorDefaultBrush}"
            RowGroupHeaderPropertyNameAlternative="Range"
            SelectionChanged="ModListGrid_OnSelectionChanged"
            SelectionMode="Extended"
            Sorting="OnColumnSort">

            <controls:DataGrid.Columns>

                <controls:DataGridTemplateColumn
                    Width="SizeToHeader"
                    CanUserSort="True"
                    ClipboardContentBinding="{Binding IsEnabled, Mode=OneWay}"
                    Header="{x:Bind ViewModel.GetLocalized('/CharacterDetailsPage/EnabledColumnHeader', 'Enabled'), Mode=OneWay}"
                    Tag="IsEnabled">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="subViewModels:ModRowVM">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <CheckBox
                                    Width="Auto"
                                    MinWidth="0"
                                    Command="{x:Bind ToggleEnabledCommand}"
                                    CommandParameter="{x:Bind}"
                                    IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                                    IsTabStop="False" />
                            </Grid>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Width="SizeToCells"
                    MinWidth="0"
                    CanUserSort="False"
                    Header=""
                    IsReadOnly="True"
                    Tag="NotificationColumn">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="subViewModels:ModRowVM">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <ItemsRepeater ItemsSource="{x:Bind ModNotifications}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="subViewModels:ModRowVM_ModNotificationVM">
                                            <Grid Margin="4,0" VerticalAlignment="Center">
                                                <Button
                                                    Margin="0"
                                                    Padding="0"
                                                    BorderThickness="0"
                                                    Click="Notification_OnClick"
                                                    CornerRadius="0"
                                                    DataContext="{x:Bind}"
                                                    PointerEntered="NotificationButton_OnPointerEntered"
                                                    PointerExited="NotificationButton_OnPointerExited"
                                                    ToolTipService.ToolTip="new version available"
                                                    l:Uids.Uid="/CharacterDetailsPage/NewVersionAvailableToolTip">
                                                    <Button.Content>
                                                        <FontIcon
                                                            VerticalAlignment="Bottom"
                                                            Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
                                                            Glyph="{x:Bind AttentionType, Converter={StaticResource AttentionTypeToSymbolConverter}}" />
                                                    </Button.Content>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTemplateColumn
                    Width="SizeToCells"
                    MinWidth="94"
                    CanUserSort="True"
                    ClipboardContentBinding="{Binding DisplayName, Mode=OneWay}"
                    Header="{x:Bind ViewModel.GetLocalized('/CharacterDetailsPage/ModNameColumnHeader', 'Mod Name'), Mode=OneWay}"
                    IsReadOnly="True"
                    Tag="DisplayName">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="subViewModels:ModRowVM">
                            <Grid Background="Transparent" CanDrag="True" DragStarting="ModRow_DragStarting" Tapped="ModNameCell_Tapped">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding FolderName, Mode=OneWay}"
                    CanUserSort="True"
                    Header="{x:Bind ViewModel.GetLocalized('/CharacterDetailsPage/FolderNameColumnHeader', 'Folder Name'), Mode=OneWay}"
                    IsReadOnly="True"
                    Tag="FolderName"
                    Visibility="{x:Bind ViewModel.IsModFolderNameColumnVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <controls:DataGridTextColumn
                    Width="SizeToCells"
                    MinWidth="85"
                    Binding="{Binding Author, Mode=OneWay}"
                    CanUserSort="True"
                    Header="{x:Bind ViewModel.GetLocalized('/CharacterDetailsPage/AuthorColumnHeader', 'Author'), Mode=OneWay}"
                    Tag="Author" />

                <controls:DataGridTemplateColumn
                    Width="SizeToHeader"
                    CanUserSort="True"
                    ClipboardContentBinding="{Binding DateAddedFormated, Mode=OneTime}"
                    Header="{x:Bind ViewModel.GetLocalized('/CharacterDetailsPage/DateAddedColumnHeader', 'Date Added'), Mode=OneWay}"
                    IsReadOnly="True"
                    Tag="DateAdded">
                    <controls:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="subViewModels:ModRowVM">
                            <Grid
                                Margin="8,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Text="{Binding DateAddedFormated, Mode=OneTime}" />
                            </Grid>
                        </DataTemplate>
                    </controls:DataGridTemplateColumn.CellTemplate>
                </controls:DataGridTemplateColumn>

                <controls:DataGridTextColumn
                    Width="SizeToCells"
                    MinWidth="85"
                    Binding="{Binding InPresets, Mode=OneWay}"
                    CanUserSort="True"
                    Header="{x:Bind ViewModel.GetLocalized('/CharacterDetailsPage/PresetsColumnHeader', 'Presets'), Mode=OneWay}"
                    IsReadOnly="True"
                    Tag="Presets" />

                <controls:DataGridTextColumn
                    x:Name="NotesColumn"
                    Width="SizeToCells"
                    MinWidth="70"
                    Binding="{Binding Description, Mode=OneWay}"
                    CanUserSort="False"
                    Header="{x:Bind ViewModel.GetLocalized('/CharacterDetailsPage/DescriptionColumnHeader', 'Notes'), Mode=OneWay}"
                    IsReadOnly="False"
                    Tag="Description" />

            </controls:DataGrid.Columns>
        </controls:DataGrid>

        <Popup
            x:Name="HoverPreviewPopup"
            IsHitTestVisible="False"
            IsOpen="False">
            <Grid
                x:Name="HoverPreviewCard"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HoverPreviewTransform" />
                </Grid.RenderTransform>

                <Canvas x:Name="HoverPreviewShadowHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <Border
                    x:Name="HoverPreviewMainBorder"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="#59FFFFFF"
                    BorderThickness="1.2"
                    CornerRadius="12"
                    Padding="7">
                    <Grid CornerRadius="6" Background="Transparent">
                        <Grid
                            x:Name="HoverPreviewPlaceholder"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="#33000000"
                            CornerRadius="6"
                            Visibility="Collapsed">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0.45"
                                Spacing="8">
                                <FontIcon FontSize="36" Glyph="&#xEB9F;" Foreground="White" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="No Preview" />
                            </StackPanel>
                        </Grid>

                        <Image
                            x:Name="HoverPreviewImage"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            ImageOpened="HoverPreviewImage_OnImageOpened" />

                        <Border
                            x:Name="HoverPreviewMetaBar"
                            VerticalAlignment="Bottom"
                            CornerRadius="0,0,6,6"
                            Padding="12,28,12,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0.0" />
                                    <GradientStop Color="#26000000" Offset="0.25" />
                                    <GradientStop Color="#8C000000" Offset="0.65" />
                                    <GradientStop Color="#E6000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Name="HoverPreviewTitle"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="HoverPreviewAuthor"
                                    FontSize="10.5"
                                    Foreground="#B8FFFFFF"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
